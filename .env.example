# 服务监听
# 本地调试可使用 0.0.0.0 方便手机局域网访问
# 生产环境放在 Nginx 后时建议设为 127.0.0.1
HOST=0.0.0.0
PORT=8788

# 部署在 Nginx 等反向代理后时设为 1，以便正确获取 HTTPS 和客户端 IP
TRUST_PROXY=0

# MongoDB 连接
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=anjian_intake

# 管理员账号。密码以 ADMIN_PASSWORD 为准，修改后重启服务即可生效并注销旧会话。
# 也可以执行 npm run set-password 自动生成新密码并写回此文件。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=please-change-this-password

# 身份证照片加密密钥：必须是 64 位十六进制字符（32 字节）
# 可用 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" 生成
FILE_ENCRYPTION_KEY=

# 管理员登录有效期（小时）
SESSION_TTL_HOURS=12

# DeepSeek 多模态识别
# 证件图片会通过服务端发送到该地址用于提取字段，请确认服务商的数据处理与留存政策
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_MS=45000

# 单次导出的最大记录数
MAX_EXPORT_ROWS=300
